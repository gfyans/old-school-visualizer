#include <winver.h>

// Icon ID 1 is loaded by src/platform/Window.cpp and used by Explorer for the exe.
1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,4,0,0
 PRODUCTVERSION  1,4,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Visualizer - music visualiser"
            VALUE "FileVersion", "1.4.0"
            VALUE "InternalName", "Visualizer"
            VALUE "OriginalFilename", "Visualizer.exe"
            VALUE "ProductName", "Visualizer"
            VALUE "ProductVersion", "1.4.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
